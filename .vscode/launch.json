{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current CMake target",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:Path};C:/Program Files/VTK/bin;"
        }
      ],
      "visualizerFile": "${workspaceFolder}/qt5.natvis",
      "console": "integratedTerminal"
    }
  ]
}