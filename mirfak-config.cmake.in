@PACKAGE_INIT@

# 包含导出目标
include("${CMAKE_CURRENT_LIST_DIR}/mirfak-targets.cmake")

# 设置包变量
set(MIRFAK_FOUND TRUE)
set(MIRFAK_VERSION @PROJECT_VERSION@)

# 检查组件
set(MIRFAK_COMPONENTS basic core sprites navigation appbase)

# 提供组件查找结果
foreach(comp ${MIRFAK_COMPONENTS})
    if(TARGET mirfak::mirfak_${comp})
        set(MIRFAK_${comp}_FOUND TRUE)
    else()
        set(MIRFAK_${comp}_FOUND FALSE)
    endif()
endforeach()

# 处理 find_package 的组件要求
if(MIRFAK_FIND_COMPONENTS)
    foreach(comp ${MIRFAK_FIND_COMPONENTS})
        if(NOT TARGET mirfak::mirfak_${comp})
            set(MIRFAK_${comp}_FOUND FALSE)
            if(MIRFAK_FIND_REQUIRED_${comp})
                set(MIRFAK_FOUND FALSE)
                set(MIRFAK_NOT_FOUND_MESSAGE 
                    "Missing required Mirfak component: ${comp}")
            endif()
        else()
            set(MIRFAK_${comp}_FOUND TRUE)
        endif()
    endforeach()
endif()

# 标准包检查
check_required_components(MIRFAK)